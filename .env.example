# Supabase 환경 변수
# https://app.supabase.com → 프로젝트 선택 → Settings → API
# 채워넣으면 실 인증/데이터로 전환, 비어있으면 mock 모드로 동작.
#
# Next.js 마이그레이션 이후 NEXT_PUBLIC_* 가 정식. VITE_* 는 레거시 fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 레거시 (선택) — Phase 5 종료 후 제거.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Sentry (에러 관측) ──────────────────────────────────────────
# 비우면 완전 no-op (전송·빌드 래핑 모두 스킵). 채우면 활성화.
# DSN: Sentry → 프로젝트 → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (빌드 시에만 필요, 클라 노출 X).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── 결제 webhook 시크릿 ─────────────────────────────────────────
# 각 결제사 대시보드의 webhook 서명 시크릿. HMAC-SHA256 검증에 사용.
# 비우면 해당 webhook 라우트는 503(미구성) 반환.
TOSS_WEBHOOK_SECRET=xxxxxxxx
LEMONSQUEEZY_WEBHOOK_SECRET=xxxxxxxx

# ── 결제 처리 (webhook → plan 갱신) ─────────────────────────────
# service-role 키: RLS 우회하여 webhook 이 profiles.plan 을 갱신. ⚠️ 절대 클라 노출 X.
# Supabase → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# ── LemonSqueezy 체크아웃 (결제 시작) ───────────────────────────
# 비우면 /api/checkout 은 501(준비 중) 반환 → UI 가 안내 노출.
# API 키: LemonSqueezy → Settings → API.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=            # 월간 요금제 variant ID
LEMONSQUEEZY_VARIANT_ID_YEARLY=     # 연간 (선택 — 없으면 월간 variant 로 폴백)
